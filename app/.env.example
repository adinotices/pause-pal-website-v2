# Postgres connection string. For Neon/Supabase, use the pooled connection
# string (works with the `prepare: false` setting in lib/db/index.ts).
DATABASE_URL="postgresql://user:password@host:5432/pausepal?sslmode=require"

# Shared admin password for /admin. Phase 1 has a single admin user, so this
# is a plain shared secret rather than a full auth system.
ADMIN_PASSWORD="change-me"

# Random secret used to sign the admin session cookie. Generate with:
#   openssl rand -hex 32
ADMIN_SESSION_SECRET="change-me-too"

# --- Phase 3: Zoom + Google Calendar (optional) -----------------------------
# All of these are optional. Without them, /admin/scheduling still computes
# and stores session times -- it just skips creating the actual Zoom
# meeting / calendar invites. See app/README.md for how to set each of
# these up (Zoom Server-to-Server OAuth app; Google service account shared
# onto a calendar).

ZOOM_ACCOUNT_ID=""
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""
# The Zoom user (by email) that hosts the created meetings.
ZOOM_HOST_EMAIL=""

GOOGLE_SERVICE_ACCOUNT_EMAIL=""
# The service account's PEM private key. Paste it with literal "\n" for
# newlines (not real line breaks) -- lib/integrations/google-calendar.ts
# unescapes them back before use.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
# The calendar to create events on (e.g. hello@pausepal.co, or a dedicated
# calendar's ID). Must be shared with the service account email above,
# with "Make changes to events" permission.
GOOGLE_CALENDAR_ID=""

# --- Phase 4: participant accounts, email, reminders (optional) -------------

# Random secret used to sign the participant (magic-link) session cookie --
# deliberately separate from ADMIN_SESSION_SECRET. Generate with:
#   openssl rand -hex 32
PARTICIPANT_SESSION_SECRET="change-me-as-well"

# This app's own canonical URL, used to build absolute links in emails
# (magic links, reminders). Set to the real app.pausepal.co URL in
# production; defaults to http://localhost:3000 if unset.
APP_URL="http://localhost:3000"

# Resend (https://resend.com) for transactional email -- magic links and
# reminders. Without RESEND_API_KEY, emails are logged to the console
# instead of sent, so login/reminders are still testable without a real
# provider.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="PausePal <hello@pausepal.co>"

# Verifies requests to /api/cron/reminders are actually from Vercel Cron
# (which sends this automatically once the var is set -- see
# https://vercel.com/docs/cron-jobs/manage-cron-jobs#securing-cron-jobs).
# Optional in development (the check is skipped when unset outside
# production); set this in production.
CRON_SECRET=""
